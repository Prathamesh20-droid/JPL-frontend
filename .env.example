# JPL Frontend Environment Configuration Example
# Duplicate this file to .env or .env.local for local overrides

# Backend REST API base URL
# Local development default: http://localhost:5000 (falls back to http://${window.location.hostname}:5000 if omitted)
# Cloud production example: https://api.yourdomain.com
REACT_APP_API_BASE_URL=http://localhost:5000

# Realtime WebSocket / Socket.IO URL
# Defaults to REACT_APP_API_BASE_URL if omitted
# Cloud production example: https://api.yourdomain.com
REACT_APP_SOCKET_URL=http://localhost:5000

# Registration Form URL (Google Form link on Register page)
REACT_APP_FORM_URL=https://forms.gle/your-registration-form
